{
  "name": "winging-it-bird-id",
  "version": "1.0.0",
  "description": "Node.js application to orchestrate downloading recorded clips from a Reolink camera and identifying birds using AI",
  "license": "MIT",
  "author": "David Stanich",
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node index.ts",
    "seed:db": "node scripts/seed-db.ts",
    "seed:uploads": "node scripts/seed-uploads.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "ftp-srv": "^4.6.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
